                {
                  "id": "bl00009",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>Blomstra es un <strong>estudio creativo</strong> donde transformamos ideas, proyectos y momentos importantes en <strong>universos estéticos con narrativa propia</strong>.</p><p>Algunos toman forma de marca. Otros se convierten en experiencias. Creemos que cuando algo se diseña con intención, la vida también puede romantizarse.</p>",
                    "_css_classes": "bl-lead bl-center"
                  },
                  "elements": []
                },
